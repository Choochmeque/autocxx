+/// How a class inherits one of its base classes.
+#[derive(Copy, Clone, Debug, PartialEq, Eq)]
+pub enum BaseKind {
+    /// Ordinary inheritance, i.e. `struct Derived : Base {};`
+    Normal,
+    /// Virtual inheritance, i.e. `struct Derived : virtual Base {};`
+    Virtual,
+}
+
+/// Relevant information about a base class, reported through
+/// [`ParseCallbacks::denote_base_class`].
+#[derive(Debug, Clone, Copy)]
+#[non_exhaustive]
+pub struct BaseClassInfo<'a> {
+    /// The class being inherited from.
+    pub base: DiscoveredItemId,
+
+    /// Whether the inheritance is virtual.
+    pub kind: BaseKind,
+
+    /// The access specifier the base is inherited with.
+    pub visibility: Visibility,
+
+    /// The field generated to store the base subobject, where one was
+    /// generated. `None` says the base exists in C++ but occupies no field:
+    /// it is virtual, or bindgen found it zero-sized.
+    pub field_name: Option<&'a str>,
+}
+
 /// Whether a C++ method has been explicitly defaulted or deleted.
