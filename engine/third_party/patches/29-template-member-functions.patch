+/// What [`ParseCallbacks::denote_template_member_function`] reports about one
+/// member function of a class template.
+#[derive(Debug, Clone, Copy)]
+#[non_exhaustive]
+pub struct TemplateMemberFunctionInfo<'a> {
+    /// The name bindgen would have generated the function under, which is the
+    /// C++ name put through the same two changes bindgen makes for a member it
+    /// does generate: a destructor's leading `~` is dropped and a
+    /// `_destructor` suffix added, and
+    /// [`ParseCallbacks::generated_name_override`] has already been consulted.
+    pub name: &'a str,
+
+    /// What kind of member function C++ declared, which is the same answer
+    /// [`ParseCallbacks::denote_method_kind`] gives for a member bindgen did
+    /// generate.
+    pub kind: MethodKind,
 
+    /// Whether C++ declared the member `const`, which says how a consumer
+    /// must take the receiver it supplies.
+    pub is_const: bool,
+
+    /// The access C++ gave the member.
+    pub visibility: Visibility,
+
+    /// Which special member this is, where it is one: the same answer
+    /// [`ParseCallbacks::denote_special_member`] gives for a member bindgen did
+    /// generate.
+    pub special_member: Option<SpecialMemberKind>,
+
+    /// Whether C++ wrote `= delete` or `= default` on the member, as
+    /// [`ParseCallbacks::denote_explicit`] reports for one bindgen did
+    /// generate. A consumer which emits a call must not emit one to a deleted
+    /// member.
+    pub explicitness: Option<Explicitness>,
+
+    /// What C++ marked the member `[[deprecated]]` with, where it did, as
+    /// [`ParseCallbacks::denote_deprecation`] reports for one bindgen did
+    /// generate.
+    pub deprecation: Option<&'a Deprecation>,
+
+    /// The ref-qualifier C++ declared the member with, which bindgen records
+    /// for no other member: for one it generates, the qualifier survives in
+    /// the mangled name a `#[link_name]` carries. A class may declare both
+    /// qualifications of one name, and they differ in nothing else reported
+    /// here, so a consumer which emits a call has to be told which it is
+    /// calling - and a `&&`-qualified member cannot be called on an lvalue at
+    /// all.
+    pub ref_qualifier: RefQualifier,
+
+    /// The signature, where it can be written down outside the template;
+    /// `None` where it cannot. See [`TemplateMemberFunctionSignature`].
+    pub signature: Option<TemplateMemberFunctionSignature<'a>>,
