+    ///
+    /// The deleted-function body is the last thing in such a declaration, so
+    /// this reads the last token rather than scanning: whatever the declaration
+    /// contains of its own - a braced default argument, a lambda, a trailing
+    /// return type, a requires-clause, an attribute, `override` - comes before
+    /// it, and nothing else a declaration can end with is the word `delete`. A
+    /// member whose body clang deferred ends at its declarator and one whose
+    /// body clang parsed ends at the body's `}`; a pure virtual ends at `0` and
+    /// a defaulted one at `default`.
+    ///
+    /// `None` where the declaration cannot be read this way, which is where a
+    /// macro wrote the end of it. The tokens are then the macro's use rather
+    /// than its replacement and say nothing about deletion, and they may not
+    /// even be the whole declaration: `void f() DELETED;` tokenizes as one
+    /// identifier, `void f() WRAP(DELETED);` as nothing past `void`, and a
+    /// declaration whose first token comes from a macro defined in another file
+    /// as nothing at all. Two things are checked for that: that the tokens
+    /// reach the end of the declaration, and that the last of them was not
+    /// written by a macro. The caller decides what to do with a declaration it
+    /// cannot read.
+    pub(crate) fn is_deleted_as_written(&self) -> Option<bool> {
+        let tokens = self.tokens();
+        let mut tail = tokens
+            .iter()
+            .filter(|token| token.kind != CXToken_Comment)
+            .collect::<Vec<_>>();
+        while tail.last().is_some_and(|token| token.spelling() == b";") {
+            tail.pop();
+        }
+        let last = tail.pop()?;
+        let reaches_the_end = unsafe {
+            let (declaration_file, declaration_end) =
+                spelling_location(clang_getRangeEnd(self.extent()));
+            let (token_file, token_end) =
+                spelling_location(clang_getRangeEnd(last.extent));
+            declaration_end == token_end &&
+                clang_File_isEqual(declaration_file, token_file) != 0
+        };
+        if !reaches_the_end || tokens.is_macro_expansion(&last) {
+            return None;
+        }
+        Some(last.spelling() == b"delete")
     }
 
