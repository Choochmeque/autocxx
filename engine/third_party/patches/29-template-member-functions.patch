+    /// Whether the Rust rendering of `ty` would name a template parameter, so
+    /// cannot be written outside the template the parameter belongs to.
+    ///
+    /// Structural, and deliberately so: a parameter is named by the parameter
+    /// itself, by a type declared inside a template - which bindgen renders
+    /// with the template's parameters in scope - and by anything built out of
+    /// either. A template instantiation's *arguments* are followed and the
+    /// parameters its definition declares are not, so `A<int>` names nothing
+    /// even though `A`'s own declaration has a parameter; the parameters that
+    /// definition is declared *inside* are another matter, and are the one
+    /// thing the definition is consulted for.
+    ///
+    /// Errs towards `true`: a type declared inside a template counts whether or
+    /// not it happens to use the parameter, and a reference bindgen never
+    /// resolved counts because nothing can be said about what it would render
+    /// as.
+    fn names_template_parameter(ctx: &BindgenContext, ty: TypeId) -> bool {
+        fn walk(
+            ctx: &BindgenContext,
+            id: ItemId,
+            seen: &mut HashSet<ItemId>,
+        ) -> bool {
+            if !seen.insert(id) {
+                // Already being answered further up the walk; whichever path
+                // introduced it decides.
+                return false;
+            }
+            let item = ctx.resolve_item(id);
+            if !item.all_template_params(ctx).is_empty() {
+                return true;
+            }
+            let Some(ty) = item.as_type() else {
+                return false;
