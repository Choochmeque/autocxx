+    /// Report each member function of a class template through
+    /// [`crate::callbacks::ParseCallbacks::denote_template_member_function`].
+    ///
+    /// The facts are the ones the generated Rust does not carry because there
+    /// is no generated Rust: bindgen emits nothing for these members, so a
+    /// consumer which writes its own C++ for a chosen instantiation has
+    /// nothing to build a call from.
+    pub(super) fn report_template_member_functions(
+        ctx: &BindgenContext,
+        item: &Item,
+        comp: &CompInfo,
+    ) {
+        let parent = DiscoveredItemId::new(item.id().as_usize());
+        // Constructors and the destructor are held apart from the other
+        // members in the IR and are member functions all the same, so they are
+        // put back together here, in the order `CompInfo::codegen` generates
+        // them in for a class which has no template parameters.
+        let mut members: Vec<Method> = comp
+            .methods()
+            .iter()
+            .map(|method| {
+                Method::new(method.kind(), method.signature(), method.is_const())
+            })
+            .collect();
+        members.extend(comp.constructors().iter().map(|signature| {
+            Method::new(MethodKind::Constructor, *signature, false)
+        }));
+        if let Some((kind, destructor)) = comp.destructor() {
+            members.push(Method::new(kind, destructor, false));
+        }
+        for method in &members {
+            let function_item = ctx.resolve_item(method.signature());
+            // The checks `Item::process_before_codegen` makes for a member
+            // which is generated, minus the once-only bookkeeping: a caller
+            // which excluded a function from codegen, by kind or by name,
+            // did not ask to hear about it either.
+            if !function_item.is_enabled_for_codegen(ctx) ||
+                function_item.is_blocklisted(ctx)
+            {
+                continue;
+            }
+            let Some(function) = function_item.kind().as_function() else {
+                continue;
+            };
+            let signature_item = ctx.resolve_item(function.signature());
+            let TypeKind::Function(ref signature) =
+                *signature_item.expect_type().kind()
+            else {
+                continue;
+            };
+            // The receiver is dropped: for a non-static member it is a
+            // pointer to the class template, which names every parameter the
+            // template has, and a consumer supplies its own anyway.
+            let arguments = signature
+                .argument_types()
+                .iter()
+                .skip(usize::from(!method.is_static()));
+            let writable =
+                !names_template_parameter(ctx, signature.return_type()) &&
+                    arguments.clone().all(|(_, ty)| {
+                        !names_template_parameter(ctx, *ty)
+                    });
+            let rendered_arguments: Vec<String> = if writable {
+                fnsig_arguments_iter(ctx, arguments, false)
+                    .into_iter()
+                    .map(|argument| argument.to_string())
+                    .collect()
+            } else {
+                Vec::new()
+            };
+            let rendered_return = match fnsig_return_ty_internal(ctx, signature)
+            {
+                syn::Type::Tuple(syn::TypeTuple { ref elems, .. })
+                    if elems.is_empty() =>
+                {
+                    None
+                }
+                ref ty => Some(ty.to_token_stream().to_string()),
+            };
+            let member = crate::callbacks::TemplateMemberFunctionInfo {
+                name: function.name(),
+                kind: method.kind(),
+                is_const: method.is_const(),
+                visibility: function.visibility(),
+                special_member: function.special_member(),
+                explicitness: if function.deleted_fn() {
+                    Some(Explicitness::Deleted)
+                } else if function.defaulted_fn() {
+                    Some(Explicitness::Defaulted)
+                } else {
+                    None
+                },
+                deprecation: function.deprecation(),
+                ref_qualifier: function.ref_qualifier(),
+                signature: writable.then_some(
+                    crate::callbacks::TemplateMemberFunctionSignature {
+                        arguments: &rendered_arguments,
+                        return_type: rendered_return.as_deref(),
+                        is_variadic: signature.is_variadic(),
+                    },
+                ),
+            };
+            ctx.options().for_each_callback(|cb| {
+                cb.denote_template_member_function(parent, member);
+            });
+        }
