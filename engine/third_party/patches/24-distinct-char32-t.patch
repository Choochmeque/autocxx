+
+    /// Whether we should distinguish between C++'s `char32_t` and `u32`.
+    ///
+    /// As with `char16_t`, the C++ type `char32_t` is its own type and not a
+    /// typedef of some other integer, and Rust has no equivalent. bindgen
+    /// collapses it to `u32`, which is the right width and the wrong type: a
+    /// C++ compiler asked to take the address of a function taking one says
+    /// so.
+    ///
+    /// When this option is enabled, bindgen generates a fake type called
+    /// `bindgen_cchar32_t`, exactly as `use_distinct_char16_t` generates
+    /// `bindgen_cchar16_t`. Downstream code post-processors should arrange to
+    /// replace this with a real type.
+    use_distinct_char32_t: bool {
+        methods: {
+            /// If this is true, denote `char32_t` as a separate type from
+            /// `u32`. Disabled by default.
+            pub fn use_distinct_char32_t(mut self, doit: bool) -> Builder {
+                self.options.use_distinct_char32_t = doit;
+                self
+            }
+        },
+        as_args: "--use-distinct-char32-t",
+    },
