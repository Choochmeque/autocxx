+    pub(super) fn callback_with_cpp_name(
+        ctx: &BindgenContext,
+        item: &Item,
+        original_name: Option<&str>,
+    ) {
+        let id = DiscoveredItemId::new(item.id().as_usize());
+        let parent = find_reportable_parent_mod(ctx, item);
+        ctx.options().for_each_callback(|cb| {
+            cb.denote_cpp_name(id, original_name, parent);
+        });
+    }
+
+    /// The nearest ancestor `ParseCallbacks` was told about. Inline namespaces
+    /// and non-module parents are not reported, so a `parent_id` handed to a
+    /// callback has to skip past them to a module the client has seen.
+    pub(super) fn find_reportable_parent_mod(
+        ctx: &BindgenContext,
+        item: &Item,
+    ) -> Option<DiscoveredItemId> {
+        let mut parent_item = ctx.resolve_item(item.parent_id());
+        while !is_reportable_module(parent_item) {
+            let parent_id = parent_item.parent_id();
+            if parent_id == parent_item.id() {
+                return None;
+            }
+            parent_item = ctx.resolve_item(parent_id);
+        }
+        Some(DiscoveredItemId::new(parent_item.id().as_usize()))
+    }
+
+    /// Full-fat namespaces only: not inline namespaces, and not other layers of
+    /// parentage such as a struct.
+    fn is_reportable_module(item: &Item) -> bool {
+        item.as_module().is_some_and(|item_mod| !item_mod.is_inline())
     }
 
