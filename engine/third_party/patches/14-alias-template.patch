+++ b/callbacks.rs
@@ -275,6 +275,27 @@
     /// syntax of its own.
     fn denote_method_kind(&self, _id: DiscoveredItemId, _kind: MethodKind) {}
 
+    /// Report that an item is a C++ alias template, with the number of
+    /// template parameters its declaration had and the number of those which
+    /// are template *type* parameters.
+    ///
+    /// The two differ when C++ declared a non-type or a template template
+    /// parameter: neither is a type, so neither survives into
+    /// `TypeKind::TemplateAlias`, and bindgen emits the alias as a plain
+    /// `pub type`, which has lost the parameters that naming the alias in C++
+    /// still takes. Nothing else distinguishes that from an ordinary typedef,
+    /// so a consumer which has to emit C++ naming the alias needs to be told.
+    /// Both counts are of what C++ declared: bindgen may still drop one of the
+    /// type parameters for being unused, which it reports through
+    /// [`ParseCallbacks::denote_discards_template_param`] instead.
+    fn denote_alias_template(
+        &self,
+        _id: DiscoveredItemId,
+        _declared_params: usize,
+        _type_params: usize,
+    ) {
+    }
+
     // TODO add callback for ResolvedTypeRef
 }
 

