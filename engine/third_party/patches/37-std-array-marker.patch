+    /// Whether the array a `std::array<T, N>` was lowered to should be wrapped
+    /// in a marker newtype saying so.
+    ///
+    /// `--represent-std-array` writes `[T; N]` for the class, which is the
+    /// object it is; but C++ also has `T[N]`, and that is written `[T; N]`
+    /// too. Nothing in the output tells a consumer which of the two it has.
+    /// That is invisible where the array stands on its own - C++ decays an
+    /// array parameter and cannot return one, so an array in either of those
+    /// positions is the class - and it is not invisible behind a pointer or a
+    /// reference, where `const T (&)[N]` and `const std::array<T, N>&` are
+    /// different C++ types a consumer may have to name apart.
+    ///
+    /// The wrapper is a fake type called `__bindgen_marker_StdArray`, to be
+    /// replaced by post-processing the output or by a `use` injected with
+    /// `--every-module-raw-line` or similar.
+    use_std_array_newtype_wrapper: bool {
+        methods: {
+            /// If this is true, wrap the array a `std::array` was lowered to
+            /// in a fake newtype wrapper which post-processors can replace
+            /// with something more sensible. Disabled by default.
+            pub fn use_std_array_newtype_wrapper(mut self, doit: bool) -> Builder {
+                self.options.use_std_array_newtype_wrapper = doit;
+                self
+            }
+        },
+        as_args: "--use-std-array-newtype-wrapper",
+    },
+
