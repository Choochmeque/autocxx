 /// An extension trait for `syn::Type` that lets us append any implicit
 /// template parameters that exist for some type, if necessary.
+/// The bounds an inner-type trait's associated type carries, which are the
+/// traits the type naming it derives: a dependent qualified name stands where
+/// a concrete type would, so it has to promise the same.
+fn associated_type_bounds(
+    ctx: &BindgenContext,
+    derivable_traits: DerivableTraits,
+) -> proc_macro2::TokenStream {
+    let prefix = ctx.trait_prefix();
+    let bounds: Vec<proc_macro2::TokenStream> = Vec::<&str>::from(
+        derivable_traits,
+    )
+    .into_iter()
+    .map(|name| match name {
+        // Every derivable trait is in the prelude except these two, which have
+        // to be named by path - through `trait_prefix`, because the prelude the
+        // bindings get may be core's.
+        "Debug" => quote! { ::#prefix::fmt::Debug },
+        "Hash" => quote! { ::#prefix::hash::Hash },
+        _ => {
+            let ident = ctx.rust_ident(name);
+            quote! { #ident }
+        }
+    })
+    .collect();
+    if bounds.is_empty() {
+        quote! {}
+    } else {
+        quote! { : #( #bounds )+* }
+    }
+}
