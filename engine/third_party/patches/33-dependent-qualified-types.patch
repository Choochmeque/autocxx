+    /// The single inner type name an associated template type looks up, where
+    /// that is what it looks up: `Associated` for `T::Associated`.
+    ///
+    /// `None` for anything which is not one, and for one which qualifies a name
+    /// that is not a single identifier - `T::Associated::Deeper` names no inner
+    /// type of `T`, so there is no trait through which to reach it. The spelling
+    /// may carry qualifiers, as `const typename T::Associated` does, and may or
+    /// may not carry the `typename` keyword depending on the clang release,
+    /// which is why only the end of it is anchored.
+    pub(crate) fn get_associated_type_name(&self) -> Option<String> {
+        // This is terrible :( - as above.
+        fn hacky_parse_associated_type_name<S: AsRef<str>>(
+            spelling: S,
+        ) -> Option<String> {
+            static ASSOC_TYPE_NAME_RE: OnceLock<regex::Regex> = OnceLock::new();
+            ASSOC_TYPE_NAME_RE
+                .get_or_init(|| {
+                    regex::Regex::new(
+                        r"(?:typename )?type\-parameter\-\d+\-\d+::(\w+)$",
+                    )
+                    .unwrap()
+                })
+                .captures(spelling.as_ref())
+                .map(|caps| caps[1].to_owned())
+        }
+
+        if self.kind() != CXType_Unexposed {
+            return None;
+        }
+        hacky_parse_associated_type_name(self.spelling()).or_else(|| {
+            hacky_parse_associated_type_name(self.canonical_type().spelling())
+        })
+    }
 }
 
