+    /// The types libclang reports as `ty`'s template arguments, in declaration
+    /// order.
+    ///
+    /// `clang_Type_getTemplateArgumentAsType` names every *type* argument of a
+    /// specialization, including those written with no cursor of their own: a
+    /// builtin, as in `Foo<T, int>`, and an argument left to its default. The
+    /// defaulted ones show up only on the canonical type, so the two lists are
+    /// chained, the canonical one supplying the tail the written one does not
+    /// reach. A non-type argument comes back as an invalid type and is dropped,
+    /// so a caller counting these against a declaration's parameters sees a
+    /// specialization with const-value arguments come up short.
+    pub(crate) fn template_arg_types(ty: &clang::Type) -> Vec<clang::Type> {
+        use clang_sys::CXType_Invalid;
+
+        let Some(args) = ty.template_args() else {
+            return vec![];
+        };
+        let arg_count = args.len();
+        match ty.canonical_type().template_args() {
+            Some(canonical_args) => args
+                .chain(canonical_args.skip(arg_count))
+                .filter(|t| t.kind() != CXType_Invalid)
+                .collect(),
+            None => args.filter(|t| t.kind() != CXType_Invalid).collect(),
+        }
+    }
