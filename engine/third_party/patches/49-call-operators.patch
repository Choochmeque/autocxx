+/// One call operator of a class, which `Function::parse` declined to make a
+/// function of for want of a name to generate it under.
+///
+/// Nothing is recorded of what it does beyond how many parameters it declares:
+/// this says that the class is callable and how, which is what an output with
+/// no function for it cannot otherwise say.
+#[derive(Debug, Clone)]
+pub(crate) struct CallOperator {
+    parameters: usize,
+    is_const: bool,
+    visibility: Visibility,
+}
+
+impl CallOperator {
+    /// Read one off a cursor bindgen made no function from.
+    ///
+    /// `None` for anything but a member C++ spells `operator()`. The spelling
+    /// is the cursor's own, not the name `Function::parse` worked with: a
+    /// consumer's `ParseCallbacks::generated_name_override` has already
+    /// rewritten that one, and a consumer which renames every function leaves
+    /// nothing there to recognise.
+    fn from_cursor(cursor: &clang::Cursor) -> Option<Self> {
+        if cursor.kind() != clang_sys::CXCursor_CXXMethod ||
+            cursor.spelling() != "operator()"
+        {
+            return None;
+        }
+        Some(Self {
+            parameters: cursor.num_args().ok()? as usize,
+            is_const: cursor.method_is_const(),
+            visibility: Visibility::from(cursor.access_specifier()),
+        })
+    }
+
+    /// How many parameters C++ declared.
+    pub(crate) fn parameters(&self) -> usize {
+        self.parameters
+    }
+
+    /// Whether C++ declared the operator `const`.
+    pub(crate) fn is_const(&self) -> bool {
+        self.is_const
+    }
+
+    /// The access C++ gave the operator.
+    pub(crate) fn visibility(&self) -> Visibility {
+        self.visibility
+    }
+}
+
