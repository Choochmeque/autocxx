+    /// Report the call operators of a struct or class through
+    /// [`crate::callbacks::ParseCallbacks::denote_call_operator`].
+    ///
+    /// Subject to `--generate=methods` as a member function is. There is no
+    /// per-member blocklist check to make, a call operator never becoming an
+    /// item for a blocklist to match.
+    pub(super) fn report_call_operators(
+        ctx: &BindgenContext,
+        parent: DiscoveredItemId,
+        comp: &CompInfo,
+    ) {
+        if !ctx.options().codegen_config.methods() {
+            return;
+        }
+        for operator in comp.call_operators() {
+            ctx.options().for_each_callback(|cb| {
+                cb.denote_call_operator(
+                    parent,
+                    CallOperatorInfo {
+                        parameters: operator.parameters(),
+                        is_const: operator.is_const(),
+                        visibility: operator.visibility(),
+                    },
+                );
+            });
+        }
+    }
