+/// What [`ParseCallbacks::denote_call_operator`] reports about one call
+/// operator.
+#[derive(Debug, Clone, Copy)]
+#[non_exhaustive]
+pub struct CallOperatorInfo {
+    /// How many parameters C++ declared, which is what tells one overload of
+    /// `operator()` from another. Not how many a call must pass: a parameter
+    /// may have a default argument.
+    pub parameters: usize,
+
+    /// Whether C++ declared the operator `const`, which says how a caller must
+    /// take the receiver.
+    pub is_const: bool,
+
+    /// The access C++ gave the operator.
+    pub visibility: Visibility,
+}
