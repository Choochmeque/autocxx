+/// Undoes [`const_wrapper`] and [`volatile_wrapper`], for the one place which
+/// needs to *name* a type rather than declare something of it: a newtype
+/// alias's constructor. A marker is not part of that constructor's name, and
+/// `Marker<Inner>(v)` is not an expression whatever the marker is defined as.
+///
+/// Both are peeled, and repeatedly, because a `const volatile` type carries
+/// one inside the other.
+pub(crate) fn strip_qualifier_wrappers(mut ty: &syn::Type) -> &syn::Type {
+    loop {
+        let syn::Type::Path(path) = ty else {
+            return ty;
+        };
+        let Some(segment) = path.path.segments.last() else {
+            return ty;
+        };
+        if segment.ident != CONST_MARKER && segment.ident != VOLATILE_MARKER {
+            return ty;
+        }
+        let syn::PathArguments::AngleBracketed(args) = &segment.arguments
+        else {
+            return ty;
+        };
+        match args.args.first() {
+            Some(syn::GenericArgument::Type(inner)) => ty = inner,
+            _ => return ty,
+        }
     }
 }
 
