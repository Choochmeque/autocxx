 /// The name of the marker newtype `const_wrapper` puts round a `const` type.
 const CONST_MARKER: &str = "__bindgen_marker_Const";
 
+/// The name of the marker newtype `volatile_wrapper` puts round a `volatile`
+/// type.
+const VOLATILE_MARKER: &str = "__bindgen_marker_Volatile";
+
+/// A type which C++ qualified `volatile` in its own right, wrapped in a marker
+/// newtype if one was asked for.
+pub(crate) fn volatile_wrapper(
+    ty: syn::Type,
+    is_volatile: bool,
+    ctx: &BindgenContext,
+) -> syn::Type {
+    if is_volatile && ctx.options().use_volatile_newtype_wrapper {
+        let marker = Ident::new(VOLATILE_MARKER, Span::call_site());
+        syn::parse_quote! { #marker < #ty > }
+    } else {
+        ty
+    }
+}
