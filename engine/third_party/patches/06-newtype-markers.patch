+    /// Use a newtype wrapper to denote "opaque" types: types where bindgen
+    /// generated something matching the size and alignment of the C++ type
+    /// without knowing what is inside it. The wrapper is a fake type called
+    /// `__bindgen_marker_Opaque`, to be replaced by post-processing the output
+    /// or by a `use` injected with `--every-module-raw-line` or similar.
+    use_opaque_newtype_wrapper: bool {
+        methods: {
+            /// If this is true, wrap opaque types in a fake newtype
+            /// wrapper which post-processors can replace with something
+            /// more sensible.
+            pub fn use_opaque_newtype_wrapper(mut self, doit: bool) -> Builder {
+                self.options.use_opaque_newtype_wrapper = doit;
+                self
+            }
+        },
+        as_args: "--use-opaque-newtype-wrapper",
+    },
+
+    /// Use a newtype wrapper to denote C++ reference types. References are
