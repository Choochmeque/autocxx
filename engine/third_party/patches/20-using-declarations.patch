+/// A `using Base::foo;` written in a class, which makes a base class member
+/// nameable through the derived class.
+///
+/// bindgen generates nothing for one - it has no signature and no symbol of
+/// its own, being a second name for a declaration which already exists - but
+/// it changes what the derived class exposes, so a consumer emitting code
+/// against that class needs to know it is there.
+#[derive(Debug, Clone)]
+pub(crate) struct UsingDeclaration {
+    name: String,
+    source_scope: Option<String>,
+    visibility: Visibility,
+}
+
+impl UsingDeclaration {
+    /// Read one off a `CXCursor_UsingDeclaration`.
+    ///
+    /// The base class comes from the `CXCursor_TypeRef` child which spells the
+    /// nested-name-specifier: `clang_getNumOverloadedDecls` looks like the
+    /// better answer and is not one, because for an overload set it hands back
+    /// a proper subset of the declarations the using-declaration actually
+    /// introduces.
+    fn from_cursor(cursor: &clang::Cursor) -> Self {
+        let mut source_scope = None;
+        cursor.visit(|child| {
+            if child.kind() == clang_sys::CXCursor_TypeRef {
+                source_scope = Some(child.cur_type().qualified_spelling());
+            }
+            clang_sys::CXChildVisit_Continue
+        });
+        Self {
+            name: cursor.spelling(),
+            source_scope,
+            visibility: Visibility::from(cursor.access_specifier()),
+        }
+    }
+
+    /// The name the declaration introduces into the class.
+    pub(crate) fn name(&self) -> &str {
+        &self.name
+    }
+
+    /// The base class the name is taken from, as C++ spells it.
+    pub(crate) fn source_scope(&self) -> Option<&str> {
+        self.source_scope.as_deref()
+    }
+
+    /// The access the declaration gives the name in the derived class, which
+    /// is the declaration's own and not the member's.
+    pub(crate) fn visibility(&self) -> Visibility {
+        self.visibility
+    }
+}
