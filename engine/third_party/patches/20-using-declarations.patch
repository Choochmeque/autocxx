+/// What [`ParseCallbacks::denote_using_declaration`] reports about one
+/// class-scope using-declaration.
+#[derive(Debug, Clone, Copy)]
+#[non_exhaustive]
+pub struct UsingDeclarationInfo<'a> {
+    /// The name the declaration introduces into the class.
+    ///
+    /// For an inherited constructor - `using Base::Base;` - clang names the
+    /// declaration after the *derived* class rather than the base, so this is
+    /// the derived class's own name.
+    pub name: &'a str,
+
+    /// The base class the name is taken from, as C++ spells it and qualified
+    /// as far as clang qualifies it. `None` where libclang exposed no
+    /// reference to name the base by.
+    ///
+    /// It does not identify which of the base's members the declaration
+    /// introduces: a using-declaration names an overload set, and libclang
+    /// reports a proper subset of it, so the honest answer is the name and the
+    /// scope to look it up in.
+    pub source_scope: Option<&'a str>,
+
+    /// The access the *declaration* was written with, which is the access the
+    /// name has in the derived class. It is what makes `using Base::foo;` in a
+    /// `public:` section the way C++ widens a `protected` member, so it is not
+    /// the member's own access and cannot be read off the member.
+    pub visibility: Visibility,
+}
