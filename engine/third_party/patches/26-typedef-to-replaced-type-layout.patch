+/// The item whose layout the Rust type written for a field actually has.
+///
+/// Usually that is the type the field was declared with, but not when a
+/// `replaces=` annotation stands another type in its place: the replacement is
+/// recorded as a `ResolvedTypeRef` on the replaced type, which goes on carrying
+/// the layout C++ gave it, while the type written for the field is the
+/// replacement's and has the replacement's size. `ItemResolver` follows
+/// `ResolvedTypeRef` for that reason, but it does not follow `Alias`, so a
+/// typedef in front of a replaced type hides the substitution and the struct is
+/// laid out - and padded - for a size the emitted field does not have.
+///
+/// So follow aliases too, and stop where the `TypeKind::Alias` arms of
+/// `TryToRustTy for Type` and `CodeGenerator for Type` write something sized
+/// from the alias rather than from what it aliases. An opaque alias is a blob
+/// of the alias's own layout, and an alias named for a type Rust already has is
+/// written as that type whatever it was declared over; those two are exactly
+/// the arms' own conditions. The third stop is deliberately wider than the arm
+/// it guards: an aliased type with no layout is only *sometimes* written as a
+/// blob of the alias's layout - conversion has to fail first - but the layout
+/// question has no answer either way, so the walk stops on the layout alone.
+fn field_representation<'a>(ctx: &'a BindgenContext, ty: TypeId) -> &'a Item {
+    let mut item = ty.into_resolver().through_type_refs().resolve(ctx);
+    let mut seen = HashSet::default();
+    while seen.insert(item.id()) {
+        let Some(alias) = item.as_type() else {
+            break;
+        };
+        let TypeKind::Alias(inner) = *alias.kind() else {
+            break;
+        };
+        if item.is_opaque(ctx, &()) ||
+            alias
+                .name()
+                .and_then(|name| utils::type_from_named(ctx, name))
+                .is_some()
+        {
+            break;
+        }
+        let next = inner.into_resolver().through_type_refs().resolve(ctx);
+        if next.as_type().and_then(|ty| ty.layout(ctx)).is_none() {
+            break;
+        }
+        item = next;
+    }
+    item
+}
+
