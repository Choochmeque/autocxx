+/// The exception specification a C++ function was declared with.
+///
+/// The variants are libclang's, and several of them say only that libclang does
+/// not know which exceptions the function allows. `ComputedNoexcept` covers
+/// `noexcept(false)` as well as `noexcept(true)`: the type's spelling carries
+/// the operand's text, but nothing carries the value clang evaluated it to, and
+/// there is no cursor for the operand to evaluate. `Dynamic` omits the types
+/// `throw(A, B)` names. `Unevaluated` is a member whose specification clang
+/// computes only on demand, which a defaulted member's is.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum ExceptionSpecification {
+    /// No specification: the function may throw anything.
+    None,
+    /// `throw()`, C++98's spelling of "throws nothing".
+    DynamicNone,
+    /// `throw(A, B)`, removed in C++17.
+    Dynamic,
+    /// `throw(...)`, a Microsoft extension.
+    MsAny,
+    /// `noexcept`, written without an operand.
+    BasicNoexcept,
+    /// `noexcept(expr)`, whose operand is not reported.
+    ComputedNoexcept,
+    /// A defaulted special member whose specification clang has not computed.
+    Unevaluated,
+    /// A member of a class template specialization whose specification has not
+    /// been instantiated.
+    Uninstantiated,
+    /// Not parsed yet.
+    Unparsed,
+    /// `__attribute__((nothrow))` or `__declspec(nothrow)`.
+    NoThrow,
+}
+
+/// What a C++ function's declaration says about exceptions, and what its
+/// canonical type says.
+///
+/// The two differ over `noexcept(expr)`. The declaration reports only that the
+/// specification is conditional. From C++17 the specification is part of the
+/// function type, and the canonical type is the one clang resolved the operand
+/// in, so `canonical` is `BasicNoexcept` or `None` there and says which way it
+/// went. Before C++17 a specification is no part of a function's type, the
+/// canonical type carries none at all, and `canonical` is `None` however the
+/// function was declared - including for one declared `noexcept`, so it may not
+/// be read on its own.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct ExceptionSpecifications {
+    /// What the declaration says, which is what libclang reports for the
+    /// function's cursor.
+    pub declared: ExceptionSpecification,
+    /// What the canonical function type carries.
+    pub canonical: ExceptionSpecification,
+}
+
+/// What libclang's exception specification kind means.
+fn exception_specification(
+    kind: CXCursor_ExceptionSpecificationKind,
+) -> ExceptionSpecification {
+    use clang_sys::*;
+    match kind {
+        CXCursor_ExceptionSpecificationKind_DynamicNone => {
+            ExceptionSpecification::DynamicNone
+        }
+        CXCursor_ExceptionSpecificationKind_Dynamic => {
+            ExceptionSpecification::Dynamic
+        }
+        CXCursor_ExceptionSpecificationKind_MSAny => {
+            ExceptionSpecification::MsAny
+        }
+        CXCursor_ExceptionSpecificationKind_BasicNoexcept => {
+            ExceptionSpecification::BasicNoexcept
+        }
+        CXCursor_ExceptionSpecificationKind_ComputedNoexcept => {
+            ExceptionSpecification::ComputedNoexcept
+        }
+        CXCursor_ExceptionSpecificationKind_Unevaluated => {
+            ExceptionSpecification::Unevaluated
+        }
+        CXCursor_ExceptionSpecificationKind_Uninstantiated => {
+            ExceptionSpecification::Uninstantiated
+        }
+        CXCursor_ExceptionSpecificationKind_Unparsed => {
+            ExceptionSpecification::Unparsed
+        }
+        CXCursor_ExceptionSpecificationKind_NoThrow => {
+            ExceptionSpecification::NoThrow
+        }
+        CXCursor_ExceptionSpecificationKind_None => ExceptionSpecification::None,
+        // The invalid kind libclang reports for a cursor which declares no
+        // function or a type which is not a function type, and a kind a later
+        // libclang adds. Both read as no specification, so a consumer which
+        // reproduces one writes none: too loose rather than too strict, which
+        // an ordinary C++ compiler rejects outright and one in
+        // Microsoft-compatibility mode accepts with a warning.
+        _ => ExceptionSpecification::None,
+    }
+}
+
