+/// The exception specification a C++ function was declared with.
+///
+/// The variants are libclang's, and several of them say only that libclang does
+/// not know which exceptions the function allows. `ComputedNoexcept` covers
+/// `noexcept(false)` as well as `noexcept(true)`: the type's spelling carries
+/// the operand's text, but nothing carries the value clang evaluated it to, and
+/// there is no cursor for the operand to evaluate. `Dynamic` omits the types
+/// `throw(A, B)` names. `Unevaluated` is a member whose specification clang
+/// computes only on demand, which a defaulted member's is.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum ExceptionSpecification {
+    /// No specification: the function may throw anything.
+    None,
+    /// `throw()`, C++98's spelling of "throws nothing".
+    DynamicNone,
+    /// `throw(A, B)`, removed in C++17.
+    Dynamic,
+    /// `throw(...)`, a Microsoft extension.
+    MsAny,
+    /// `noexcept`, written without an operand.
+    BasicNoexcept,
+    /// `noexcept(expr)`, whose operand is not reported.
+    ComputedNoexcept,
+    /// A defaulted special member whose specification clang has not computed.
+    Unevaluated,
+    /// A member of a class template specialization whose specification has not
+    /// been instantiated.
+    Uninstantiated,
+    /// Not parsed yet.
+    Unparsed,
+    /// `__attribute__((nothrow))` or `__declspec(nothrow)`.
+    NoThrow,
+}
+
