 use crate::ir::layout::Layout;
-use crate::ir::ty::RUST_DERIVE_IN_ARRAY_LIMIT;
+use crate::ir::ty::{FloatKind, RUST_DERIVE_IN_ARRAY_LIMIT};
 
 pub(crate) mod attributes {
     use proc_macro2::{Ident, Span, TokenStream};
@@ -186,6 +186,31 @@
     }
 }
 
+/// The name of the marker newtype `long_double_wrapper` puts round a
+/// `long double`.
+const LONG_DOUBLE_MARKER: &str = "__bindgen_marker_LongDouble";
+
+/// A C++ `long double`, wrapped in a marker newtype if one was asked for.
+///
+/// `ty` is what `float_kind_rust_type` chose for it, which is right about the
+/// size and silent about everything else: `f64` where the type is eight bytes,
+/// an integer of the same width where it is not. The marker says which of
+/// those two the caller is looking at, without changing either.
+pub(crate) fn long_double_wrapper(
+    ty: syn::Type,
+    kind: FloatKind,
+    ctx: &BindgenContext,
+) -> syn::Type {
+    if kind == FloatKind::LongDouble &&
+        ctx.options().use_long_double_newtype_wrapper
+    {
+        let marker = Ident::new(LONG_DOUBLE_MARKER, Span::call_site());
+        syn::parse_quote! { #marker < #ty > }
+    } else {
+        ty
+    }
+}
+
