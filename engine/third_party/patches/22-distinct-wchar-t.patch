             IntKind::LongLong => raw_type(ctx, "c_longlong"),
             IntKind::ULongLong => raw_type(ctx, "c_ulonglong"),
+            // As with `bindgen_cchar16_t` above, and for the same reason: the
+            // integer of the right width is not the same type as `wchar_t`,
+            // and it is the caller - compiled for the target - which knows
+            // whether that integer is signed.
+            IntKind::WChar if ctx.options().use_distinct_wchar_t => {
+                syn::parse_quote! { bindgen_cwchar_t }
+            }
             IntKind::WChar => {
                 let layout =
                     layout.expect("Couldn't compute wchar_t's layout?");
