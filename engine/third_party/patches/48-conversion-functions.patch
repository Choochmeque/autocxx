+/// What [`ParseCallbacks::denote_conversion_function`] reports about one
+/// conversion function.
+#[derive(Debug, Clone, Copy)]
+#[non_exhaustive]
+pub struct ConversionFunctionInfo<'a> {
+    /// What the function converts to, as libclang spells the type it was
+    /// declared to return.
+    ///
+    /// A qualified C++ spelling rather than a Rust one: bindgen makes no item
+    /// for a conversion function, so there is no signature it rendered for this
+    /// to agree with, and the name is there to be looked up. The spelling is
+    /// the declaration's own, which for a class template may name a parameter
+    /// of the class - `operator T` reports `T` - because nothing here
+    /// instantiates anything.
+    pub target_type: &'a str,
+
+    /// Whether C++ declared the function `const`, which says how a caller must
+    /// take the receiver.
+    pub is_const: bool,
+
+    /// The access C++ gave the function.
+    pub visibility: Visibility,
+}
