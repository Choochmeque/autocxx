+    ///
+    /// Subject to `--generate=methods` as a member function is, and reported
+    /// beside the other reports every class makes rather than from the point
+    /// codegen gives up on a class template's members: a conversion function
+    /// belongs to an ordinary class as readily as to a class template and is
+    /// generated for neither. There is no per-member blocklist check to make, a
+    /// conversion function never becoming an item for a blocklist to match.
+    pub(super) fn report_conversion_functions(
+        ctx: &BindgenContext,
+        parent: DiscoveredItemId,
+        comp: &CompInfo,
+    ) {
+        if !ctx.options().codegen_config.methods() {
+            return;
+        }
+        for function in comp.conversion_functions() {
+            ctx.options().for_each_callback(|cb| {
+                cb.denote_conversion_function(
+                    parent,
+                    ConversionFunctionInfo {
+                        target_type: function.target_type(),
+                        is_const: function.is_const(),
+                        visibility: function.visibility(),
+                    },
+                );
+            });
+        }
+    }
