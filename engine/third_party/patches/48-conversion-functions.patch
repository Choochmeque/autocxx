+/// One conversion function of a class.
+///
+/// bindgen parses no member from a `CXCursor_ConversionFunction`, so this is
+/// the only thing which says such a member exists.
+///
+/// What it converts to is kept and what it is called is not: a conversion
+/// function's C++ name is `operator` followed by the type, so the type is the
+/// whole of the name which distinguishes one from another.
+#[derive(Debug, Clone)]
+pub(crate) struct ConversionFunction {
+    target_type: String,
+    is_const: bool,
+    visibility: Visibility,
+}
+
+impl ConversionFunction {
+    /// Read one off a `CXCursor_ConversionFunction` found among a class's
+    /// children.
+    ///
+    /// The target type comes from `clang_getCursorResultType` rather than from
+    /// the cursor's spelling, which prints the type through a policy of its own
+    /// and has the word `operator` in front of it. Qualified, because the name
+    /// is there to be looked up: `Type::spelling` drops the qualification a
+    /// consumer would need to find `std::string` rather than some `string`.
+    fn from_cursor(cursor: &clang::Cursor) -> Option<Self> {
+        Some(Self {
+            target_type: cursor.ret_type()?.qualified_spelling(),
+            is_const: cursor.method_is_const(),
+            visibility: Visibility::from(cursor.access_specifier()),
+        })
+    }
+
+    /// What the function converts to, as libclang spells it.
+    pub(crate) fn target_type(&self) -> &str {
+        &self.target_type
+    }
+
+    /// Whether C++ declared the function `const`.
+    pub(crate) fn is_const(&self) -> bool {
+        self.is_const
+    }
+
+    /// The access C++ gave the function.
+    pub(crate) fn visibility(&self) -> Visibility {
+        self.visibility
+    }
+}
