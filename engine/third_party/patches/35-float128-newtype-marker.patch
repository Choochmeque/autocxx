+/// The name of the marker newtype `float128_wrapper` puts round a
+/// `__float128`.
+const FLOAT128_MARKER: &str = "__bindgen_marker_Float128";
+
+/// A C++ `__float128`, wrapped in a marker newtype if one was asked for.
+///
+/// `ty` is what `float_kind_rust_type` chose for it, which is `u128`: Rust has
+/// no 128-bit float, so the type comes out as the integer of the same width -
+/// indistinguishable in the output from an `unsigned __int128`, which really
+/// is that integer. The marker says which of the two is being looked at,
+/// without changing either.
+pub(crate) fn float128_wrapper(
+    ty: syn::Type,
+    kind: FloatKind,
+    ctx: &BindgenContext,
+) -> syn::Type {
+    if kind == FloatKind::Float128 && ctx.options().use_float128_newtype_wrapper
+    {
+        let marker = Ident::new(FLOAT128_MARKER, Span::call_site());
+        syn::parse_quote! { #marker < #ty > }
+    } else {
+        ty
+    }
+}
