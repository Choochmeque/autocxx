+/// The names a namespace declares, by what kind of name each one is.
+///
+/// Kept apart because which pairs of kinds cannot share a module is not the
+/// same question for each. A variable or a function is only ever filed here by
+/// a declaration that is really there, and two of them under one name is either
+/// a redefinition or - worse, since bindgen drops the second - the wrong value
+/// quietly standing in for the right one. A module is the same, and a module
+/// sharing a name with a type is a redefinition too, Rust having one namespace
+/// for both.
+///
+/// Two *types* are the exception, and are allowed to meet. bindgen parents a
+/// type into whichever module was being traversed when the type was first
+/// referred to, so a namespace appears to declare types it merely mentions -
+/// `uint32_t`, or a type declared outside it and named in one of its members -
+/// and refusing on those would refuse almost everything. A consumer which
+/// meets two types under one name can see that it has, which is not true of
+/// the value that silently went missing.
+#[derive(Default)]
+struct Declarations {
+    values: HashSet<String>,
+    modules: HashSet<String>,
+    types: HashSet<String>,
+}
+
+impl Declarations {
+    /// Whether emitting these declarations alongside `outer` would put two
+    /// things under one name.
+    fn collides_with(&self, outer: &Self) -> bool {
+        let shares = |a: &HashSet<String>, b: &HashSet<String>| {
+            a.iter().any(|name| b.contains(name))
+        };
+        shares(&self.values, &outer.values) ||
+            shares(&self.modules, &outer.modules) ||
+            shares(&self.modules, &outer.types) ||
+            shares(&self.types, &outer.modules)
+    }
+
+    fn absorb(&mut self, other: Self) {
+        self.values.extend(other.values);
+        self.modules.extend(other.modules);
+        self.types.extend(other.types);
+    }
+}
+
