+    /// name. Unlike an inline namespace an unnamed one can hold a name the
+    /// enclosing namespace also holds, which is legal precisely because its
+    /// members have internal linkage, and C++ resolves the qualified name to
+    /// the enclosing declaration rather than finding both. Such a namespace
+    /// keeps its module, under the name `Item::base_name` invents for it,
+    /// because that module is the only thing left which tells the two apart.
+    ///
+    /// See `Declarations::collides_with` for which pairs of names count.
+    fn compute_transparent_unnamed_namespaces(&mut self) {
+        let _t = self.timer("compute_transparent_unnamed_namespaces");
+        assert!(self.transparent_unnamed_namespaces.is_none());
+
+        let mut transparent = HashSet::default();
+        self.fold_unnamed_namespaces(self.root_module.into(), &mut transparent);
+        self.transparent_unnamed_namespaces = Some(transparent);
+    }
+
+    /// What the module `id` declares once its own transparent children have
+    /// been folded into it, deciding those children on the way back up.
+    ///
+    /// Deepest first, so that an unnamed namespace inside an unnamed namespace
+    /// is judged against the first named scope above them both, which is where
+    /// both sets of names would land.
+    fn fold_unnamed_namespaces(
+        &self,
+        id: ItemId,
+        transparent: &mut HashSet<ItemId>,
+    ) -> Declarations {
+        let mut declared = Declarations::default();
+        let Some(module) = self.resolve_item(id).as_module() else {
+            return declared;
+        };
+        let mut unnamed = Vec::new();
+        for child in module.children() {
+            match self.resolve_item(*child).as_module() {
+                Some(child_module) if child_module.name().is_none() => {
+                    unnamed.push(*child);
+                }
+                Some(child_module) => {
+                    let names = self.fold_unnamed_namespaces(*child, transparent);
+                    // An inline namespace is emitted into this module too, so
+                    // what it declares arrives here and has to be counted here.
+                    if child_module.is_inline() &&
+                        !self.options().conservative_inline_namespaces
+                    {
+                        declared.absorb(names);
+                    } else {
+                        self.record_declaration(&mut declared, *child);
+                    }
+                }
+                None => self.record_declaration(&mut declared, *child),
+            }
+        }
+        for child in unnamed {
+            let names = self.fold_unnamed_namespaces(child, transparent);
+            if names.collides_with(&declared) {
+                self.record_declaration(&mut declared, child);
+            } else {
+                declared.absorb(names);
+                transparent.insert(child);
+            }
+        }
+        declared
+    }
+
+    /// File an item under the name it declares in the module holding it, and
+    /// under what kind of name that is.
+    ///
+    /// The name codegen will emit, which for a type nested in another type is
+    /// the two names joined - `Outer::Inner` is emitted as `Outer_Inner`, and
+    /// what it can collide with is a module of that name.
+    ///
+    /// Walked here rather than asked of `Item::real_canonical_name`, which
+    /// would consult the very decision being taken. The walk stops where that
+    /// one does, at the first enclosing module, so it never needs to.
+    fn declared_name(&self, id: ItemId) -> String {
+        let mut names = Vec::new();
+        let mut item = self.resolve_item(id);
+        loop {
+            names.push(self.resolve_item(item.name_target(self)).base_name(self));
+            let parent = self.resolve_item(item.parent_id());
+            if parent.is_module() || parent.id() == item.id() {
+                break;
+            }
+            item = parent;
+        }
+        names.reverse();
+        names.retain(|name| !name.is_empty());
+        names.join("_")
+    }
+
+    fn record_declaration(&self, declared: &mut Declarations, id: ItemId) {
+        let item = self.resolve_item(id);
+        let name = self.declared_name(id);
+        match item.kind() {
+            ItemKind::Module(..) => declared.modules.insert(name),
+            ItemKind::Var(..) | ItemKind::Function(..) => {
+                declared.values.insert(name)
+            }
+            ItemKind::Type(..) => declared.types.insert(name),
+        };
+    }
+
+    /// Whether this is an unnamed namespace whose members are emitted in the
+    /// namespace enclosing it. See
+    /// `compute_transparent_unnamed_namespaces`.
+    pub(crate) fn is_transparent_unnamed_namespace<Id: Into<ItemId>>(
+        &self,
+        id: Id,
+    ) -> bool {
+        self.transparent_unnamed_namespaces
+            .as_ref()
+            .expect("unnamed namespaces are resolved as codegen is entered")
+            .contains(&id.into())
+    }
