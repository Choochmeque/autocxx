+/// The name of the marker newtype `const_wrapper` puts round a `const` type.
+const CONST_MARKER: &str = "__bindgen_marker_Const";
+
+/// A type which C++ qualified `const` in its own right, wrapped in a marker
+/// newtype if one was asked for.
+pub(crate) fn const_wrapper(
+    ty: syn::Type,
+    is_const: bool,
+    ctx: &BindgenContext,
+) -> syn::Type {
+    if is_const && ctx.options().use_const_newtype_wrapper {
+        let marker = Ident::new(CONST_MARKER, Span::call_site());
+        syn::parse_quote! { #marker < #ty > }
+    } else {
+        ty
+    }
+}
+
+/// Undoes [`const_wrapper`], for the one place which needs to *name* a type
+/// rather than declare something of it: a newtype alias's constructor. The
+/// marker is not part of that constructor's name, and `Marker<Inner>(v)` is
+/// not an expression whatever the marker is defined as.
+pub(crate) fn strip_const_wrapper(ty: &syn::Type) -> &syn::Type {
+    let syn::Type::Path(path) = ty else {
+        return ty;
+    };
+    let Some(segment) = path.path.segments.last() else {
+        return ty;
+    };
+    if segment.ident != CONST_MARKER {
+        return ty;
+    }
+    let syn::PathArguments::AngleBracketed(args) = &segment.arguments else {
+        return ty;
+    };
+    match args.args.first() {
+        Some(syn::GenericArgument::Type(inner)) => inner,
+        _ => ty,
+    }
+}
+
