+    /// Report that C++ marked a function or method deprecated, along with the
+    /// message the attribute was written with.
+    ///
+    /// `[[deprecated]]`, `__attribute__((deprecated))` and
+    /// `__declspec(deprecated)` all arrive here. The marker is encoded in no
+    /// mangled name and in no part of the generated Rust, so a consumer which
+    /// emits code of its own - Rust wanting `#[deprecated]`, or C++ which has
+    /// to name the function and would draw `-Wdeprecated-declarations` for it
+    /// - has no other way to learn of it.
+    ///
+    /// Reported for functions and methods, and for the marker each carries
+    /// itself. A deprecated type or variable is not reported at all, and a
+    /// function is not reported for a deprecation it inherits from an
+    /// enclosing declaration - a deprecated namespace or class - because
+    /// libclang answers for the declaration alone.
+    fn denote_deprecation(
+        &self,
+        _id: DiscoveredItemId,
+        _deprecation: &Deprecation,
     ) {
     }
 
