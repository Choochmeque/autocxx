+    /// The deprecation C++ marked this cursor's referent with, if it marked it
+    /// at all.
+    ///
+    /// `clang_getCursorAvailability` answers whether anything deprecated the
+    /// declaration - `[[deprecated]]`, `__attribute__((deprecated))` and
+    /// `__declspec(deprecated)` all come back as `CXAvailability_Deprecated` -
+    /// but it drops the message. `clang_getCursorPlatformAvailability` is what
+    /// carries that, and is asked here for no platform entries at all: a plain
+    /// deprecation names no platform, and entries would only have to be freed
+    /// again.
+    ///
+    /// It answers for this declaration and no other. A member of a class or a
+    /// namespace which is itself `[[deprecated]]` reports as available here,
+    /// even though naming it is what draws the warning, so an enclosing
+    /// deprecation has to be looked for on the enclosing declaration.
+    pub(crate) fn deprecation(&self) -> Option<Deprecation> {
+        if unsafe { clang_getCursorAvailability(self.x) } !=
+            CXAvailability_Deprecated
+        {
+            return None;
+        }
+        // clang writes all four out-parameters before it looks at anything, so
+        // an empty `CXString` here is only ever replaced, and disposing of one
+        // clang did not write is a no-op.
+        let mut always_deprecated = 0;
+        let mut always_unavailable = 0;
+        let mut deprecated_message = CXString {
+            data: ptr::null(),
+            private_flags: 0,
+        };
+        let mut unavailable_message = CXString {
+            data: ptr::null(),
+            private_flags: 0,
+        };
+        unsafe {
+            clang_getCursorPlatformAvailability(
+                self.x,
+                &mut always_deprecated,
+                &mut deprecated_message,
+                &mut always_unavailable,
+                &mut unavailable_message,
+                ptr::null_mut(),
+                0,
+            );
+            clang_disposeString(unavailable_message);
+        }
+        let message = cxstring_into_string(deprecated_message);
+        Some(Deprecation::new(
+            (!message.is_empty()).then_some(message),
+        ))
+    }
+
