+/// A deprecation marker on a C++ declaration, and what it was written with.
+///
+/// A struct rather than the message alone so that the other things a
+/// deprecation can carry - a replacement, a version, the platforms an
+/// availability attribute names - have somewhere to go later.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Deprecation {
+    message: Option<String>,
+}
+
+impl Deprecation {
+    pub(crate) fn new(message: Option<String>) -> Self {
+        Self { message }
+    }
+
+    /// The message the attribute was written with, if it was written with one:
+    /// `[[deprecated("use bar instead")]]` has one and `[[deprecated]]` does
+    /// not.
+    pub fn message(&self) -> Option<&str> {
+        self.message.as_deref()
     }
 }
 
