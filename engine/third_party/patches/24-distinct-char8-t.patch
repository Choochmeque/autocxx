+    /// Whether we should recognise C++20's `char8_t` at all.
+    ///
+    /// libclang has no `CXType_Char8` - its kinds go `CXType_UChar`,
+    /// `CXType_Char16`, `CXType_Char32`, with no slot for the type C++20
+    /// added - so `char8_t` reaches bindgen as an unexposed type and comes out
+    /// as an opaque blob of one byte. It is nonetheless identifiable, because
+    /// clang spells it `char8_t`, which is what this option matches on.
+    ///
+    /// When this option is enabled, such a type generates a fake type called
+    /// `bindgen_cchar8_t`, exactly as `use_distinct_char16_t` generates
+    /// `bindgen_cchar16_t`. Downstream code post-processors should arrange to
+    /// replace this with a real type.
+    use_distinct_char8_t: bool {
+        methods: {
+            /// If this is true, denote `char8_t` as its own type rather than
+            /// leaving it opaque. Disabled by default.
+            pub fn use_distinct_char8_t(mut self, doit: bool) -> Builder {
+                self.options.use_distinct_char8_t = doit;
+                self
+            }
+        },
+        as_args: "--use-distinct-char8-t",
+    },
