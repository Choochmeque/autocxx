+/// A type's name as clang prints it, without its own qualifiers, so that
+/// `const fx_BU` and `fx_BU` are the one name.
+///
+/// Only the qualifiers the type reports are taken off, and on whichever side
+/// clang prints them: a name which merely begins with one of those words keeps
+/// it, and so does `const int *`, which is a pointer that is not itself const.
+/// `restrict` is not among them - it qualifies a pointer, and a pointer is not
+/// a name a using-declaration introduces.
+fn unqualified_spelling(ty: &clang::Type) -> String {
+    let mut name = ty.qualified_spelling();
+    for (qualified, qualifier) in
+        [(ty.is_const(), "const"), (ty.is_volatile(), "volatile")]
+    {
+        if !qualified {
+            continue;
+        }
+        if let Some(rest) = name.strip_prefix(qualifier) {
+            if let Some(rest) = rest.strip_prefix(' ') {
+                name = rest.to_owned();
+                continue;
+            }
+        }
+        if let Some(rest) = name.strip_suffix(qualifier) {
+            name = rest.trim_end().to_owned();
+        }
+    }
+    name
 }
 
