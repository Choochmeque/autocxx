+/// One member function template of a class.
+///
+/// bindgen generates nothing for one - a template has no monomorphization to
+/// name - and does not parse one as a member of its class either, libclang
+/// reporting it as a `CXCursor_FunctionTemplate`. So this is the only thing
+/// which says such a member exists.
+///
+/// There is no signature here: this records that the member exists and what C++
+/// declared it as. A member function template's signature may name the member's
+/// own template parameters, which nothing outside the member can write.
+#[derive(Debug, Clone)]
+pub(crate) struct MemberFunctionTemplate {
+    name: String,
+    kind: MethodKind,
+    is_const: bool,
+    visibility: Visibility,
+    template_parameters: usize,
+}
+
+impl MemberFunctionTemplate {
+    /// Read one off a `CXCursor_FunctionTemplate` found among a class's
+    /// children.
+    ///
+    /// `clang_getTemplateCursorKind` answers with the kind the declaration
+    /// would have had had it not been a template, and among a class's children
+    /// it answers one of three: a member function, a constructor, and a
+    /// conversion function. The last is passed over, as a conversion function
+    /// of any other kind already is here, and could not be reported as it
+    /// stands in any case - libclang spells one `operator type-parameter-0-0`
+    /// rather than `operator T`.
+    ///
+    /// Those three are all C++ allows here - [temp.mem]/2 rules out a
+    /// destructor template and [temp.mem]/3 a virtual member function
+    /// template - so the two taken are every kind reported.
+    fn from_cursor(cursor: &clang::Cursor) -> Option<Self> {
+        let kind = match cursor.template_kind() {
+            clang_sys::CXCursor_CXXMethod if cursor.method_is_static() => {
+                MethodKind::Static
+            }
+            clang_sys::CXCursor_CXXMethod => MethodKind::Normal,
+            clang_sys::CXCursor_Constructor => MethodKind::Constructor,
+            _ => return None,
+        };
+        Some(Self {
+            name: cursor.spelling(),
+            kind,
+            is_const: cursor.method_is_const(),
+            visibility: Visibility::from(cursor.access_specifier()),
+            // The parameters the member declares, a pack counting as the one
+            // parameter it is: libclang exposes no test for a pack, and the
+            // count is of what C++ declared rather than of what a call supplies.
+            template_parameters: cursor
+                .collect_children()
+                .iter()
+                .filter(|child| child.is_template_parameter())
+                .count(),
+        })
+    }
+
+    /// The member's name, as C++ spells it.
+    pub(crate) fn name(&self) -> &str {
+        &self.name
+    }
+
+    /// Which kind of member function the template declares.
+    pub(crate) fn kind(&self) -> MethodKind {
+        self.kind
+    }
+
+    /// Whether C++ declared the member `const`.
+    pub(crate) fn is_const(&self) -> bool {
+        self.is_const
+    }
+
+    /// The access C++ gave the member.
+    pub(crate) fn visibility(&self) -> Visibility {
+        self.visibility
+    }
+
+    /// How many template parameters the member declares of its own.
+    pub(crate) fn template_parameters(&self) -> usize {
+        self.template_parameters
+    }
+}
