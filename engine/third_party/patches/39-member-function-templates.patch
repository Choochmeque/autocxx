+    /// Report the member function templates of a struct or class through
+    /// [`crate::callbacks::ParseCallbacks::denote_member_function_template`].
+    ///
+    /// Reported for a class which has template parameters in scope as well as
+    /// for one which has none, because a member function template is a member
+    /// of either and is generated for neither. That is also why this sits here,
+    /// beside the other reports made for every class, rather than beside
+    /// `report_template_member_functions`, which speaks only for the class
+    /// whose members codegen gave up on.
+    ///
+    /// A member whose kind `--generate` leaves out is not reported: a caller
+    /// which excluded a kind of function from codegen did not ask to hear about
+    /// it. There is no per-member blocklist check to make, a member function
+    /// template never becoming an item for a blocklist to match.
+    pub(super) fn report_member_function_templates(
+        ctx: &BindgenContext,
+        parent: DiscoveredItemId,
+        comp: &CompInfo,
+    ) {
+        for member in comp.member_function_templates() {
+            let wanted = match member.kind() {
+                MethodKind::Constructor => {
+                    ctx.options().codegen_config.constructors()
+                }
+                _ => ctx.options().codegen_config.methods(),
+            };
+            if !wanted {
+                continue;
+            }
+            ctx.options().for_each_callback(|cb| {
+                cb.denote_member_function_template(
+                    parent,
+                    MemberFunctionTemplateInfo {
+                        name: member.name(),
+                        kind: member.kind(),
+                        is_const: member.is_const(),
+                        visibility: member.visibility(),
+                        template_parameters: member.template_parameters(),
+                    },
+                );
+            });
+        }
+    }
