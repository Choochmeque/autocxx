+/// What [`ParseCallbacks::denote_member_function_template`] reports about one
+/// member function template.
+#[derive(Debug, Clone, Copy)]
+#[non_exhaustive]
+pub struct MemberFunctionTemplateInfo<'a> {
+    /// The member's name as C++ spells it.
+    ///
+    /// The C++ name rather than a generated one, unlike the name
+    /// [`TemplateMemberFunctionInfo`] carries: bindgen makes no item for a
+    /// member function template, so [`ParseCallbacks::generated_name_override`]
+    /// is never asked about one and there is no rename to undo.
+    pub name: &'a str,
+
+    /// Which kind of member function the template declares:
+    /// [`MethodKind::Normal`], [`MethodKind::Static`] or
+    /// [`MethodKind::Constructor`]. No other kind is reported: [temp.mem]/2
+    /// rules out a destructor template and [temp.mem]/3 a virtual member
+    /// function template, and a conversion function template is passed over.
+    pub kind: MethodKind,
+
+    /// Whether C++ declared the member `const`, which says how a caller must
+    /// take the receiver.
+    pub is_const: bool,
+
+    /// The access C++ gave the member.
+    pub visibility: Visibility,
+
+    /// How many template parameters the member declares of its own. Not how
+    /// many a caller must write: deduction and default template arguments may
+    /// supply them. A parameter pack counts as the one parameter C++ declared
+    /// it as, whatever number of arguments it goes on to take.
+    pub template_parameters: usize,
+}
