+/// Extra C++ facts autocxx needs which vanilla bindgen does not record.
+#[derive(Debug)]
+pub(crate) struct AutocxxFuncInfo {
+    /// C++ special member kind, if applicable.
+    special_member: Option<SpecialMemberKind>,
+    /// C++ access specifier.
+    visibility: Visibility,
+    /// `= delete`
+    is_deleted: bool,
+    /// `= default`
+    is_defaulted: bool,
+}
+
+impl AutocxxFuncInfo {
+    fn new(
+        special_member: Option<SpecialMemberKind>,
+        visibility: Visibility,
+        is_deleted: bool,
+        is_defaulted: bool,
+    ) -> Self {
+        Self {
+            special_member,
+            visibility,
+            is_deleted,
+            is_defaulted,
+        }
+    }
+
+    /// Get this function's C++ special member kind.
+    pub fn special_member(&self) -> Option<SpecialMemberKind> {
+        self.special_member
+    }
+
+    /// This function's C++ access specifier.
+    pub fn visibility(&self) -> Visibility {
+        self.visibility
+    }
+
+    /// Whether this function is `= delete`.
+    pub fn deleted_fn(&self) -> bool {
+        self.is_deleted
+    }
+
+    /// Whether this function is `= default`.
+    pub fn defaulted_fn(&self) -> bool {
+        self.is_defaulted
+    }
+}
+
