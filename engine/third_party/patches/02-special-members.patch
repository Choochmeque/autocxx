+/// The kind of C++ special member.
+// Copy assignment and move assignment are not covered: libclang offers no way
+// to query for them.
+#[derive(Debug, Copy, Clone, PartialEq)]
+pub enum SpecialMemberKind {
+    /// The default constructor.
+    DefaultConstructor,
+    /// A copy constructor.
+    CopyConstructor,
+    /// A move constructor.
+    MoveConstructor,
+    /// A destructor.
+    Destructor,
+    /// The assignment operator.
+    AssignmentOperator,
+}
