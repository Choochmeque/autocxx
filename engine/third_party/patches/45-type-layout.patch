+
+/// The size and alignment of a type, as [`ParseCallbacks::denote_layout`]
+/// reports them, in bytes. See there for the one shape where they are
+/// bindgen's own answer rather than what C++'s `sizeof` and `alignof` say.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+#[non_exhaustive]
+pub struct TypeLayout {
+    /// The type's size in bytes, including any tail padding.
+    pub size: usize,
+    /// The type's alignment in bytes.
+    pub align: usize,
 }
 
