+    /// Report the size and alignment bindgen laid a type out to.
+    ///
+    /// That is the number the generated Rust is padded and aligned to hold.
+    /// `--layout-tests` writes it into the bindings as an assertion, but that
+    /// is one switch over the whole output and the number itself reaches
+    /// nothing else. A consumer which renders the same objects a second way -
+    /// C++ of its own which constructs one in Rust-owned storage, or another
+    /// language's view - has no other way to check that its rendering and this
+    /// one agree about how big the object is.
+    ///
+    /// It is what clang measured wherever clang measured it, which is
+    /// everything but a union whose members clang could not lay out: for one
+    /// of those it is the widest member bindgen could measure, not rounded up
+    /// to the alignment, which is what bindgen itself lays the union out to.
+    ///
+    /// Called for each struct, union and enum codegen writes out, once, before
+    /// its fields; not called for a type with no layout at all, which is so
+    /// for a forward declaration and for most of what a class template's own
+    /// pattern can be.
+    fn denote_layout(&self, _id: DiscoveredItemId, _layout: TypeLayout) {}
