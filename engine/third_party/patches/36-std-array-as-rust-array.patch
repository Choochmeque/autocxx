+/// One argument of a template specialization, as libclang reports it on the
+/// specialization's cursor.
+#[derive(Debug)]
+pub(crate) enum TemplateArgument {
+    /// A type argument.
+    Type(Type),
+    /// A constant of integral type, as the value it was written with. Read
+    /// signed: a `std::size_t` argument larger than `i64::MAX` comes back
+    /// negative, and every caller here rejects a negative length.
+    Integral(i64),
+    /// Anything else - a template, a pack, an expression libclang did not
+    /// evaluate.
+    Other,
 }
 
