+    /// The template arguments of a specialization, as libclang reports them
+    /// on the cursor.
+    ///
+    /// `Type::template_args` names only the *type* arguments - a non-type
+    /// argument comes back from it as an invalid type - so a specialization
+    /// written with a constant cannot be told apart from one written without
+    /// it. This asks the cursor instead, where each argument carries its kind
+    /// and, for an integral one, its value.
+    ///
+    /// `None` where the referent is not a specialization.
+    pub(crate) fn template_arguments(&self) -> Option<Vec<TemplateArgument>> {
+        let count: c_int =
+            unsafe { clang_Cursor_getNumTemplateArguments(self.x) };
+        if count < 0 {
+            return None;
+        }
+        Some(
+            (0..count as c_uint)
+                .map(|i| {
+                    let kind = unsafe {
+                        clang_Cursor_getTemplateArgumentKind(self.x, i)
+                    };
+                    match kind {
+                        CXTemplateArgumentKind_Type => {
+                            TemplateArgument::Type(Type {
+                                x: unsafe {
+                                    clang_Cursor_getTemplateArgumentType(
+                                        self.x, i,
+                                    )
+                                },
+                            })
+                        }
+                        CXTemplateArgumentKind_Integral => {
+                            TemplateArgument::Integral(unsafe {
+                                clang_Cursor_getTemplateArgumentValue(self.x, i)
+                                    as i64
+                            })
+                        }
+                        _ => TemplateArgument::Other,
+                    }
+                })
+                .collect(),
+        )
+    }
+}
