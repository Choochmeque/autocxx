+/// The element type and length of a `std::array<T, N>` which `[T; N]` is the
+/// same object as, or `None` for anything else.
+///
+/// bindgen cannot model `std::array`'s own definition - its member has type
+/// `T[N]`, and `N` is a non-type template parameter - so the template
+/// declaration is opaque and so is every specialization of it. What that costs
+/// is the element type: a `std::array<uint32_t, 3>` and a `std::array<Elem, 3>`
+/// are both twelve bytes, and both come out as the same blob.
+///
+/// The standard makes `std::array<T, N>` an aggregate holding those `N` `T`s
+/// contiguously, so `[T; N]` is that object. It does not say `sizeof` is
+/// `N * sizeof(T)`, so the layout clang reports is checked rather than assumed,
+/// and an implementation which put anything else in one keeps the blob.
+///
+/// `N == 0` never matches. A zero-length `std::array` is still an object with a
+/// size - libc++ gives one a whole `T` - and `[T; 0]` has none, so the two are
+/// not the same type however they are spelled.
+fn std_array_shape(
+    ty: &clang::Type,
+    ctx: &BindgenContext,
+) -> Option<(clang::Type, usize)> {
+    let declaration = ty.declaration();
+    if declaration.spelling() != "array" || !is_directly_in_std(&declaration) {
+        return None;
+    }
+    let arguments = declaration.template_arguments()?;
+    let [
+        clang::TemplateArgument::Type(element),
+        clang::TemplateArgument::Integral(len),
+    ] = arguments.as_slice()
+    else {
+        return None;
+    };
+    let len = usize::try_from(*len).ok()?;
+    if len == 0 {
+        return None;
+    }
+    // The element has to be one `[T; N]` names as the same C++ type it was
+    // written with, and two kinds are not.
+    //
+    // A C array: `std::array<uint8_t[2], 3>` and
+    // `std::array<std::array<uint8_t, 2>, 3>` are different classes laid out
+    // the same way, and both would be `[[u8; 2]; 3]`.
+    //
+    // A `const` or `volatile` one: the qualifier is part of the template
+    // argument, Rust has nowhere to put it, and `std::array<const uint8_t, 3>`
+    // would come out spelled as `std::array<uint8_t, 3>`.
+    let canonical_element = element.canonical_type();
+    if element.is_const() ||
+        canonical_element.is_const() ||
+        element.is_volatile() ||
+        canonical_element.is_volatile() ||
+        matches!(
+            canonical_element.kind(),
+            clang_sys::CXType_ConstantArray |
+                clang_sys::CXType_IncompleteArray |
+                clang_sys::CXType_VariableArray |
+                clang_sys::CXType_DependentSizedArray
+        )
+    {
+        return None;
+    }
+    let element_size = element.fallible_size(ctx).ok()?;
+    if ty.fallible_size(ctx).ok()? != element_size.checked_mul(len)? ||
+        ty.fallible_align(ctx).ok()? != element.fallible_align(ctx).ok()?
+    {
+        return None;
+    }
+    Some((*element, len))
+}
+
+/// Whether `declaration` is declared in namespace `std` itself.
+///
+/// A standard library puts its declarations in an inline namespace inside
+/// `std` for versioning - `std::__1` in libc++, `std::__cxx11` in libstdc++ -
+/// and C++ finds a name in one by looking in `std`, which is the sense in
+/// which `std::array` is the class those declare. So those are stepped over
+/// here. (The mangled name keeps them, which is why this cannot be done by
+/// spelling.)
+fn is_directly_in_std(declaration: &Cursor) -> bool {
+    let mut scope = declaration.fallible_semantic_parent();
+    while let Some(parent) = scope {
+        if parent.kind() != clang_sys::CXCursor_Namespace {
+            return false;
+        }
+        if !parent.is_inline_namespace() {
+            // Nothing may enclose it: `std` is a top-level namespace, and a
+            // `mine::std::array` is not the one this is about.
+            return parent.spelling() == "std" &&
+                match parent.fallible_semantic_parent() {
+                    None => true,
+                    Some(grandparent) => {
+                        grandparent.kind() != clang_sys::CXCursor_Namespace
+                    }
+                };
+        }
+        scope = parent.fallible_semantic_parent();
+    }
+    false
+}
