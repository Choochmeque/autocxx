+/// The module a `--report-function-templates` report is keyed by: the scope
+/// C++ declares the template in, resolved the way the parent of every item
+/// codegen announces is resolved. `None` for a cursor which is not a
+/// namespace-scope function template after all.
+///
+/// The semantic parent rather than the point of traversal, because the two
+/// part ways for an out-of-line definition: `template <class T> int
+/// a::pick(const T&) { ... }` stands lexically wherever the file put it and
+/// belongs to `a` all the same, so keying by traversal would misfile it twice
+/// over - `a`'s own report lost, a same-named function at the file's scope
+/// wrongly shadowed. A linkage specification is transparent to name lookup
+/// and is stepped over. A record is not expected here at all - a member
+/// function template's out-of-line definition is the cursor which would have
+/// one, and `clang_getTemplateCursorKind` calls that a method rather than a
+/// function, so the caller's filter already dropped it - but a scope this
+/// walk does not recognise answers `None` and reports nothing, rather than
+/// filing a name under a namespace it does not belong to.
+///
+/// An inline namespace is then flattened to the nearest enclosing namespace
+/// which is not inline, exactly as `find_reportable_parent_mod` does for
+/// everything codegen announces: an inline namespace's contents are announced
+/// under that enclosing module, and a report keyed by the inline module's own
+/// id would name a module the consumer never hears of - while the namespace's
+/// declarations, an inline namespace being transparent to name lookup, shadow
+/// the enclosing scope's names all the same. The walk terminates because the
+/// root module is not inline.
+fn function_template_module(
+    cursor: &clang::Cursor,
+    ctx: &mut BindgenContext,
+) -> Option<DiscoveredItemId> {
+    use clang_sys::*;
+    let mut scope = cursor.fallible_semantic_parent();
+    let mut module_id: ItemId = loop {
+        let Some(parent) = scope else {
+            break ctx.root_module().into();
+        };
+        // The translation unit is recognised by identity rather than by
+        // kind: libclang renumbered `CXCursor_TranslationUnit` in
+        // libclang 15, so the constant matches the running library only
+        // when clang-sys was built for the right side of that line, and
+        // the rest of this crate accordingly never consults it.
+        if parent == ctx.translation_unit().cursor() {
+            break ctx.root_module().into();
+        }
+        match parent.kind() {
+            CXCursor_Namespace => break ctx.module(parent).into(),
+            CXCursor_LinkageSpec | CXCursor_UnexposedDecl => {
+                scope = parent.fallible_semantic_parent();
+            }
+            _ => return None,
+        }
+    };
+    while ctx
+        .resolve_item(module_id)
+        .as_module()
+        .is_some_and(Module::is_inline)
+    {
+        module_id = ctx.resolve_item(module_id).parent_id();
     }
+    Some(DiscoveredItemId::new(module_id.as_usize()))
 }
 
