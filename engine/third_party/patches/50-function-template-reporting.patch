+/// What [`ParseCallbacks::denote_function_template`] reports about one
+/// namespace-scope function template.
+#[derive(Debug, Clone, Copy)]
+#[non_exhaustive]
+pub struct FunctionTemplateInfo<'a> {
+    /// The template's name as C++ spells it. There is no rename to undo:
+    /// bindgen makes no item for a function template, so
+    /// [`ParseCallbacks::generated_name_override`] is never asked about one.
+    pub name: &'a str,
+
+    /// How many template parameters the template declares. Not how many a
+    /// caller must write: deduction and default template arguments may supply
+    /// them. A parameter pack counts as the one parameter C++ declared it as,
+    /// whatever number of arguments it goes on to take.
+    pub template_parameters: usize,
+}
+
 /// What [`ParseCallbacks::denote_conversion_function`] reports about one
 /// conversion function.
 #[derive(Debug, Clone, Copy)]
