+    /// Whether this field declaration carries a default member initializer:
+    /// `int x = 5;` and `int x{5};` do, `int x;` does not. `None` means the
+    /// question could not be put to clang, which is so for a declaration
+    /// produced by a macro expansion.
+    ///
+    /// libclang exposes no query for one, and the child cursors do not answer
+    /// it either. They include expressions which belong to the *type* rather
+    /// than to the field - an array bound - and clang's cursor visitor stops
+    /// at a bitfield's width expression without ever visiting the initializer
+    /// which may follow it, so a bitfield's is not among them at all.
+    ///
+    /// The tokens do answer it. The scan starts past the declarator-id - past
+    /// the width expression as well for a bitfield - and takes a `=` outside
+    /// any bracket as an initializer, because nothing in a declarator spells
+    /// one there. A `{` is not so simple, since a braced template argument in
+    /// a trailing return type is one too, so it counts only while everything
+    /// passed at bracket depth zero has been part of the declarator.
+    ///
+    /// A macro expansion is excluded rather than answered because the token
+    /// range clang gives such a declaration spans the macro's definition as
+    /// well as its use, and so contains tokens which are not the field's. A
+    /// declarator whose brackets come out of macros is not excluded by that,
+    /// and reads as an unrecognised token at depth zero, so it answers "no
+    /// initializer" - the direction which costs a consumer a constructor
+    /// rather than inventing one.
+    pub(crate) fn has_default_member_initializer(&self) -> Option<bool> {
+        if self.is_from_macro_expansion() {
+            return None;
+        }
+
+        let mut anchor = unsafe {
+            spelling_location(clang_getRangeEnd(self.name_extent())).1
+        };
+        if self.is_bit_field() {
+            // The width expression is the last cursor clang visits for a
+            // bitfield, so anything past it belongs to the initializer.
+            if let Some(width) = self.collect_children().last() {
+                let width_end = unsafe {
+                    spelling_location(clang_getRangeEnd(width.extent())).1
+                };
+                anchor = anchor.max(width_end);
+            }
+        }
+
+        let tokens = self.tokens();
+        let mut depth = 0usize;
+        let mut declarator_only = true;
+        for token in tokens.iter() {
+            if token.kind == CXToken_Comment {
+                continue;
+            }
+            let start = unsafe {
+                spelling_location(clang_getRangeStart(token.extent)).1
+            };
+            if start < anchor {
+                continue;
+            }
+            match token.spelling() {
+                b"(" | b"[" | b"<:" => depth += 1,
+                b")" | b"]" | b":>" => depth = depth.saturating_sub(1),
+                b"=" if depth == 0 => return Some(true),
+                b"{" | b"<%" if depth == 0 && declarator_only => {
+                    return Some(true)
+                }
+                // Part of the declarator, and its operand is parenthesised.
+                b"noexcept" => {}
+                _ if depth == 0 => declarator_only = false,
+                _ => {}
+            }
+        }
+        Some(false)
+    }
+
+    /// The source range of the name this cursor declares.
+    fn name_extent(&self) -> CXSourceRange {
+        unsafe { clang_Cursor_getSpellingNameRange(self.x, 0, 0) }
+    }
+
+    /// Whether this cursor's location was produced by expanding a macro, as
+    /// opposed to being written where it is used.
+    fn is_from_macro_expansion(&self) -> bool {
+        unsafe {
+            let location = clang_getCursorLocation(self.x);
+            let (spelling_file, spelling_offset) = spelling_location(location);
+            let (expansion_file, expansion_offset) =
+                expansion_location(location);
+            spelling_offset != expansion_offset ||
+                clang_File_isEqual(spelling_file, expansion_file) == 0
+        }
+    }
