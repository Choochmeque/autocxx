+/// What [`ParseCallbacks::denote_data_member`] reports about one data member
+/// of a struct or union.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+#[non_exhaustive]
+pub struct DataMemberInfo<'a> {
+    /// The member's C++ name, put through the same mangling as the field
+    /// bindgen generates for it. That is the field's name where one is
+    /// generated; a bitfield gets accessors instead, whose names are derived
+    /// from this one but may carry a suffix to avoid colliding with a method.
+    /// `None` for an unnamed bitfield, which gets neither.
+    pub name: Option<&'a str>,
+
+    /// Whether C++ qualified the member's own type `const`, as opposed to it
+    /// pointing at something `const`. Rust has no spelling for the former, so
+    /// it is otherwise lost - and for a bitfield it is lost even with
+    /// `--use-const-newtype-wrapper`, which can only reach the accessors.
+    pub is_const: bool,
+
+    /// The member's width in bits, if it is a bitfield.
+    pub bitfield_width: Option<u32>,
+
+    /// Whether the member has a default member initializer: `int x = 5;` and
+    /// `int x{5};` do, `int x;` does not. It is one of the things C++ weighs
+    /// when deciding whether the class has an implicitly declared default
+    /// constructor, and nothing in the generated Rust says which way it went.
+    ///
+    /// `None` where clang could not be asked, which is so for a member
+    /// declared by a macro expansion. Consumers should read that as "assume
+    /// the worst" rather than as `false`.
+    pub has_default_member_initializer: Option<bool>,
+}
