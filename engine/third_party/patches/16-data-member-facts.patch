+    /// Report the data members of a struct or union through
+    /// [`crate::callbacks::ParseCallbacks::denote_data_member`], the
+    /// bitfields included.
+    pub(super) fn report_data_members(
+        ctx: &BindgenContext,
+        parent: DiscoveredItemId,
+        comp: &CompInfo,
+    ) {
+        let report = |member: &dyn FieldMethods| {
+            let name =
+                member.name().map(|name| ctx.rust_mangle(name).into_owned());
+            // The member's own type, unresolved: `through_type_refs()` would
+            // resolve away the wrapper which holds the `const` qualifier.
+            let is_const =
+                ctx.resolve_type(member.ty()).is_const_through_aliases(ctx);
+            ctx.options().for_each_callback(|cb| {
+                cb.denote_data_member(
+                    parent,
+                    DataMemberInfo {
+                        name: name.as_deref(),
+                        is_const,
+                        bitfield_width: member.bitfield_width(),
+                        has_default_member_initializer: member
+                            .has_default_member_initializer(),
+                    },
+                );
+            });
+        };
+        for field in comp.fields() {
+            match field {
+                Field::DataMember(data) => report(data),
+                Field::Bitfields(unit) => {
+                    unit.bitfields().iter().for_each(|bf| report(bf));
+                }
+            }
+        }
+    }
